{
  "name": "jobagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assistant personnel de recherche d'emploi et de candidature",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --clear-screen=false src/server.ts\" \"vite\"",
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:live": "LIVE=1 vitest run tests/live",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli.ts migrate",
    "cli": "tsx src/cli.ts",
    "vercel-build": "tsx src/cli.ts migrate && vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.6",
    "@vercel/functions": "^3.11.1",
    "docx": "^9.15.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.7",
    "nodemailer": "^10.5.0",
    "pdfmake": "^0.3.14",
    "postgres": "^4.1.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wouter": "^3.13.0"
  }
}
